+        # expert_outputs 的 shape: (num_experts_per_tok, hidden_size)
+        # 最终结果 final_output 的 shape: (1, hidden_size)
+        final_output = ops.matmul(flat_expert_weights.T, expert_outputs)
+        
+        return final_output
 
